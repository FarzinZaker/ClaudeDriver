# ClaudeDriver — environment configuration TEMPLATE
# Copy this file to `.env` and fill in the values. `.env` is gitignored — never commit real secrets.
# In AWS, these map to Secrets Manager / SSM Parameter Store values injected into the backend.

# ---------------------------------------------------------------------------
# Core backend
# ---------------------------------------------------------------------------
CLAUDEDRIVER_ENV=dev                      # dev | staging | prod
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
BACKEND_PUBLIC_URL=                       # public HTTPS URL of the backend (e.g. https://claudedriver.example.com)

# ---------------------------------------------------------------------------
# Database (Amazon RDS for PostgreSQL / Aurora Serverless v2)
# ---------------------------------------------------------------------------
DATABASE_URL=                             # jdbc:postgresql://<rds-endpoint>:5432/claudedriver?sslmode=require
DATABASE_USER=
DATABASE_PASSWORD=

# ---------------------------------------------------------------------------
# Operator authentication — SELF-HOSTED passkeys / WebAuthn (no external IdP) — Principle I
# ---------------------------------------------------------------------------
WEBAUTHN_RP_ID=                           # relying-party id = registrable domain, e.g. claudedriver.example.com
WEBAUTHN_RP_NAME=ClaudeDriver
WEBAUTHN_ORIGIN=                           # allowed origin, e.g. https://claudedriver.example.com
SESSION_SIGNING_KEY=                       # random 32+ byte base64 secret for signing operator sessions
OPERATOR_BOOTSTRAP_CODE=                   # one-time code to register the first operator passkey

# ---------------------------------------------------------------------------
# Agent ↔ backend security (mTLS device identity) — Principles I & IV
# ---------------------------------------------------------------------------
CA_CERT_PATH=                             # CA cert that signs agent device certs
CA_KEY_PATH=                              # CA private key (store in Secrets Manager in prod)
AGENT_ENROLLMENT_SECRET=                  # signing secret for short-lived enrollment codes

# Shared secret injected into each machine's Claude Code HTTP hook Authorization header.
# On each machine set BACKEND_TOKEN to this value; it is allowlisted via httpHookAllowedEnvVars.
HOOK_SHARED_TOKEN=

# ---------------------------------------------------------------------------
# Push notifications (Amazon SNS mobile push / Pinpoint → FCM + APNs) — Phase 2
# ---------------------------------------------------------------------------
SNS_PLATFORM_APP_ARN_ANDROID=             # SNS platform application ARN for FCM (Android)
SNS_PLATFORM_APP_ARN_IOS=                 # SNS platform application ARN for APNs (iOS)
FCM_SERVER_KEY=                           # FCM credential registered with the SNS/Pinpoint platform app
APNS_KEY_ID=                              # Apple push key id
APNS_TEAM_ID=
APNS_AUTH_KEY_PATH=                       # path to the .p8 APNs auth key
APNS_BUNDLE_ID=                           # iOS app bundle id

# ---------------------------------------------------------------------------
# AWS account / hosting — Principle VII (cost attribution)
# ---------------------------------------------------------------------------
AWS_REGION=                               # e.g. us-east-1
AWS_ACCESS_KEY_ID=                        # prefer an IAM role in prod; keys only for local/dev
AWS_SECRET_ACCESS_KEY=
SECRETS_MANAGER_PREFIX=claudedriver/      # namespace for this project's secrets
# Cost grouping: every provisioned resource MUST carry these tags (enforced in infra-as-code).
PROJECT_TAG=ClaudeDriver                  # cost-allocation tag value: Project=ClaudeDriver
ENVIRONMENT_TAG=dev                       # cost-allocation tag value: Environment=<env>
