# ClaudeDriver — environment configuration TEMPLATE
# Copy this file to `.env` and fill in the values. `.env` is gitignored — never commit real secrets.
# In Azure, these map to Key Vault secrets / Container App settings.

# ---------------------------------------------------------------------------
# Core backend
# ---------------------------------------------------------------------------
CLAUDEDRIVER_ENV=dev                      # dev | staging | prod
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
BACKEND_PUBLIC_URL=                       # public HTTPS URL of the backend (e.g. https://claudedriver.<region>.azurecontainerapps.io)

# ---------------------------------------------------------------------------
# Database (Azure Database for PostgreSQL Flexible Server)
# ---------------------------------------------------------------------------
DATABASE_URL=                             # jdbc:postgresql://<host>:5432/claudedriver?sslmode=require
DATABASE_USER=
DATABASE_PASSWORD=

# ---------------------------------------------------------------------------
# Operator authentication (Microsoft Entra ID / OIDC) — Principle I
# ---------------------------------------------------------------------------
OIDC_ISSUER=                              # e.g. https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=                        # e.g. https://<backend>/auth/callback
SESSION_SIGNING_KEY=                      # random 32+ byte base64 secret for signing operator sessions

# ---------------------------------------------------------------------------
# Agent ↔ backend security (mTLS device identity) — Principles I & IV
# ---------------------------------------------------------------------------
CA_CERT_PATH=                             # path to the CA cert that signs agent device certs
CA_KEY_PATH=                              # path to the CA private key (Key Vault in prod)
AGENT_ENROLLMENT_SECRET=                  # short-lived enrollment code signing secret

# Shared secret injected into each machine's Claude Code HTTP hook Authorization header.
# On each machine set BACKEND_TOKEN to this value; it is allowlisted via httpHookAllowedEnvVars.
HOOK_SHARED_TOKEN=

# ---------------------------------------------------------------------------
# Push notifications (Azure Notification Hubs → FCM + APNs) — Phase 2
# ---------------------------------------------------------------------------
NOTIFICATION_HUB_CONNECTION_STRING=
NOTIFICATION_HUB_NAME=
# If wiring FCM/APNs directly instead of Notification Hubs:
FCM_SERVICE_ACCOUNT_JSON=                 # path to the Firebase service-account JSON (Android push)
APNS_KEY_ID=                              # Apple push key id (iOS push)
APNS_TEAM_ID=
APNS_AUTH_KEY_PATH=                       # path to the .p8 APNs auth key
APNS_BUNDLE_ID=                           # iOS app bundle id

# ---------------------------------------------------------------------------
# Secrets store (prod) — Azure Key Vault
# ---------------------------------------------------------------------------
AZURE_KEY_VAULT_URI=                      # e.g. https://claudedriver-kv.vault.azure.net/
AZURE_TENANT_ID=
AZURE_CLIENT_ID=                          # managed identity / service principal for Key Vault access
AZURE_CLIENT_SECRET=
